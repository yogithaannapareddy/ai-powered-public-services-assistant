# ================================================================
# AI-Powered Public Services Assistant - Environment Configuration
# ================================================================

# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2

# Embedding Configuration
# Options: "gemini" (uses models/text-embedding-004) or "huggingface" (local sentence-transformers fallback)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Vector Database Path
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# Document Ingestion Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=10

# Application Settings
DEFAULT_LANGUAGE=English
ENABLE_VOICE=True

